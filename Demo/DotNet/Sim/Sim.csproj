<Project Sdk="Microsoft.NET.Sdk">
  <!-- 跑局工程(17 号票):两种落子策略与规范化轨迹,命令行参数见 Program.cs,轨迹只写 stdout。
       测试工程经 ProjectReference 引它:同进程那几路直接调,子进程那一路跑的就是测试输出目录里这份 Sim.dll。
       策略是测试与定标的工具,不进规则核心、不随包发;阶段 6 的批量跑局在它上面加。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>GameRules.Sim</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameRules\GameRules.csproj" />
  </ItemGroup>
</Project>
