  {"key": "gene.5.desc", "zh": "每被消 1 格 J 或 L 块，+0.5 倍率", "en": "+0.5 mult per cleared J or L cell"},
  {"key": "gene.5.name", "zh": "钩爪基因", "en": "Hook Gene"},
  {"key": "gene.50.desc", "zh": "线数 ≥ 4 时，+30 倍率", "en": "+30 mult on 4+ lines"},
  {"key": "gene.50.name", "zh": "极线基因", "en": "Extreme Line Gene"},
