  {"key": "gene.4.name", "zh": "斜行基因", "en": "Slant Gene"},
  {"key": "gene.40.desc", "zh": "消除里同时有行和列时，+8 倍率", "en": "+8 mult if the clear has both a row and a column"},
  {"key": "gene.40.name", "zh": "十字基因", "en": "Cross Gene"},
  {"key": "gene.41.desc", "zh": "消除里有 ≥ 2 条相邻的行或相邻的列时，+50 底分", "en": "+50 chips if the clear has 2+ adjacent rows or columns"},
  {"key": "gene.41.name", "zh": "平行基因", "en": "Parallel Gene"},
  {"key": "gene.42.desc", "zh": "线数 ≥ 3 时，+12 倍率", "en": "+12 mult on 3+ lines"},
  {"key": "gene.42.name", "zh": "三重基因", "en": "Triple Gene"},
  {"key": "gene.43.desc", "zh": "线数 ≥ 2 时，+50 底分", "en": "+50 chips on 2+ lines"},
  {"key": "gene.43.name", "zh": "并线基因", "en": "Twin Track Gene"},
  {"key": "gene.44.desc", "zh": "线数 ≥ 3 时，+100 底分", "en": "+100 chips on 3+ lines"},
  {"key": "gene.44.name", "zh": "叠线基因", "en": "Stack Line Gene"},
  {"key": "gene.45.desc", "zh": "消除类型是拐角时，+15 倍率", "en": "+15 mult on a Corner clear"},
  {"key": "gene.45.name", "zh": "拐角基因", "en": "Elbow Gene"},
  {"key": "gene.46.desc", "zh": "每被消 1 行，+3 倍率", "en": "+3 mult per cleared row"},
  {"key": "gene.46.name", "zh": "横向基因", "en": "Horizon Gene"},
  {"key": "gene.47.desc", "zh": "本局每打出过 1 次这次的消除类型，+0.5 倍率", "en": "+0.5 mult per time this run you\u0027ve made this clear type"},
  {"key": "gene.47.name", "zh": "累计基因", "en": "Tally Gene"},
  {"key": "gene.48.desc", "zh": "单线消除时 ×2 倍率；线数 ≥ 2 时 −8 倍率", "en": "×2 mult on a single line; −8 mult on 2+ lines"},
  {"key": "gene.48.name", "zh": "一线基因", "en": "Single Line Gene"},
  {"key": "gene.49.desc", "zh": "这次的消除类型不是单线、且本盲注已经打出过时，×2 倍率", "en": "×2 mult if this clear type (not Single Line) was already made this blind"},
