  {"key": "gene.1.name", "zh": "直脊基因", "en": "Spine Gene"},
  {"key": "gene.10.desc", "zh": "同形态判定里，S 与 Z 算一种、J 与 L 算一种", "en": "In same-shape checks, S/Z and J/L count as one shape each"},
  {"key": "gene.10.name", "zh": "镜合基因", "en": "Mirror Gene"},
  {"key": "gene.100.desc", "zh": "每带 1 个其他基因，+2 倍率", "en": "+2 mult per other gene"},
  {"key": "gene.100.name", "zh": "群聚基因", "en": "Swarm Gene"},
  {"key": "gene.101.desc", "zh": "每次消除 +0 到 +20 倍率（随机）", "en": "+0 to +20 mult each clear, rolled at random"},
  {"key": "gene.101.name", "zh": "乱码基因", "en": "Typo Gene"},
  {"key": "gene.102.desc", "zh": "+4 倍率", "en": "+4 mult"},
  {"key": "gene.102.name", "zh": "本源基因", "en": "Origin Gene"},
  {"key": "gene.103.desc", "zh": "每次消除的首个被消格，重触发 2 次", "en": "Retrigger the first cleared cell twice"},
  {"key": "gene.103.name", "zh": "首重基因", "en": "First Weight Gene"},
  {"key": "gene.104.desc", "zh": "每个盲注开始时吞掉右邻的基因，本基因永久 +（被吞者卖价 × 2）倍率", "en": "Each blind start devours the gene to its right: permanently +2x that gene\u0027s sell price as mult"},
  {"key": "gene.104.name", "zh": "吞噬基因", "en": "Devour Gene"},
  {"key": "gene.105.desc", "zh": "商店和补给包里可以出现已持有的基因", "en": "Already-owned genes can appear in shops and packs"},
  {"key": "gene.105.name", "zh": "重现基因", "en": "Reappear Gene"},
  {"key": "gene.106.desc", "zh": "其他基因的卖价总和，加进倍率", "en": "Adds the sell value of your other genes to mult"},
  {"key": "gene.106.name", "zh": "估值基因", "en": "Appraisal Gene"},
  {"key": "gene.107.desc", "zh": "复制右邻基因的效果", "en": "Copies the effect of the gene to its right"},
  {"key": "gene.107.name", "zh": "拓印基因", "en": "Blueprint Gene"},
  {"key": "gene.108.desc", "zh": "基因段结束时，底分与倍率取平均（两者都变成 (底分 + 倍率) / 2）", "en": "At the end of the gene segment, chips and mult both become their average"},
  {"key": "gene.108.name", "zh": "均衡基因", "en": "Balance Gene"},
  {"key": "gene.109.desc", "zh": "复制最左边那个基因的效果（自己在最左时无效）", "en": "Copies the leftmost gene\u0027s effect; useless when it is leftmost itself"},
  {"key": "gene.109.name", "zh": "溯首基因", "en": "First Echo Gene"},
  {"key": "gene.11.desc", "zh": "每个盲注开始时随机指定一种形状；被消格里有这种形状时，×1.5 倍率", "en": "Each blind picks a random shape; x1.5 mult when cleared cells include it"},
  {"key": "gene.11.name", "zh": "古形基因", "en": "Ancient Gene"},
  {"key": "gene.110.desc", "zh": "铁芯块每被消 1 格，再 +1 倍率", "en": "+1 more mult per cleared steel cell"},
  {"key": "gene.110.name", "zh": "铁心基因", "en": "Iron Heart Gene"},
  {"key": "gene.111.desc", "zh": "没有强化的块，被消的每格 +3 底分", "en": "+3 chips per cleared cell of an unenhanced block"},
  {"key": "gene.111.name", "zh": "素块基因", "en": "Plain Block Gene"},
  {"key": "gene.112.desc", "zh": "带版本的块，被消的每格 +1 倍率", "en": "+1 mult per cleared cell of a block with an edition"},
  {"key": "gene.112.name", "zh": "闪光基因", "en": "Shine Gene"},
  {"key": "gene.113.desc", "zh": "万态块每被消 1 格，+8 底分", "en": "+8 chips per cleared wild cell"},
  {"key": "gene.113.name", "zh": "万象基因", "en": "Myriad Gene"},
  {"key": "gene.114.desc", "zh": "×(1 + 0.2 × 方块库里的铁芯块数) 倍率", "en": "×(1 + 0.2 × steel blocks in your library) mult"},
  {"key": "gene.114.name", "zh": "铁库基因", "en": "Iron Vault Gene"},
  {"key": "gene.115.desc", "zh": "每碎 1 块琉璃，本基因 +×0.5 倍率，从 ×1 起", "en": "+x0.5 mult permanently per glass block shattered, starting from x1"},
  {"key": "gene.115.name", "zh": "碎璃基因", "en": "Glass Shards Gene"},
  {"key": "gene.116.desc", "zh": "每个盲注第一次消除后，这次被消格最多的那块变成金箔块", "en": "After the first clear each blind, the most-cleared block becomes gold"},
  {"key": "gene.116.name", "zh": "点金基因", "en": "Midas Gene"},
  {"key": "gene.117.desc", "zh": "被消的强化块失去强化；每失去 1 块，本基因 +×0.1 倍率，从 ×1 起", "en": "Cleared enhanced blocks lose their enhancement; +x0.1 mult permanently per block"},
  {"key": "gene.117.name", "zh": "汲取基因", "en": "Drain Gene"},
  {"key": "gene.118.desc", "zh": "每个盲注结束时，1/4 概率给方块库里随机 1 块没版本的块加一个随机版本", "en": "1/4 chance at each blind\u0027s end to give a random un-editioned library block a random edition"},
  {"key": "gene.118.name", "zh": "镀版基因", "en": "Plate Gene"},
  {"key": "gene.119.desc", "zh": "这次被消格里有 ≥ 2 块带同一种强化时，+10 倍率", "en": "+10 mult if 2+ cleared blocks share an enhancement"},
  {"key": "gene.119.name", "zh": "共振基因", "en": "Resonance Gene"},
  {"key": "gene.12.desc", "zh": "被消格里同时有 O 块和 T 块时，×2 倍率", "en": "×2 mult if cleared cells include both O and T blocks"},
  {"key": "gene.12.name", "zh": "重影基因", "en": "Double Vision Gene"},
  {"key": "gene.120.desc", "zh": "琉璃块的碎裂概率减半", "en": "Glass shatter chance is halved"},
  {"key": "gene.120.name", "zh": "坚璃基因", "en": "Tough Glass Gene"},
  {"key": "gene.121.desc", "zh": "方块库里带强化的块 ≥ 9 块时，×3 倍率。代价：每个盲注开始时，网格随机 2 格变死格", "en": "×3 mult if 9+ library blocks are enhanced. Cost: 2 dead cells each blind"},
  {"key": "gene.121.name", "zh": "铭牌基因", "en": "License Gene"},
  {"key": "gene.122.desc", "zh": "方块库每比开局多 1 块，+3 底分", "en": "+3 chips per block above your starting library size"},
  {"key": "gene.122.name", "zh": "厚库基因", "en": "Thick Library Gene"},
  {"key": "gene.123.desc", "zh": "方块库里的形状种类每少于 7 种 1 种，+4 倍率", "en": "+4 mult per shape missing from your library"},
  {"key": "gene.123.name", "zh": "形数基因", "en": "Few Shapes Gene"},
  {"key": "gene.124.desc", "zh": "商店里的方块货 −$1", "en": "Blocks cost $1 less in the shop"},
  {"key": "gene.124.name", "zh": "选块基因", "en": "Picky Gene"},
  {"key": "gene.125.desc", "zh": "方块库每比开局少 1 块，+2 倍率", "en": "+2 mult per block below your starting library size"},
  {"key": "gene.125.name", "zh": "侵蚀基因", "en": "Erosion Gene"},
  {"key": "gene.126.desc", "zh": "每个盲注开始时，往方块库加 1 块随机形状、点数 1 的临时块，盲注结束移走", "en": "Each blind start adds a random 1-point temporary block; removed at blind end"},
  {"key": "gene.126.name", "zh": "增殖基因", "en": "Proliferate Gene"},
  {"key": "gene.127.desc", "zh": "每个盲注结束时，删掉方块库里点数最低的 1 块（并列取随机）", "en": "At each blind\u0027s end, destroy the lowest-point block in the library (random on ties)"},
  {"key": "gene.127.name", "zh": "剔除基因", "en": "Cull Gene"},
  {"key": "gene.128.desc", "zh": "方块库 ≤ 20 块时，被消的每格 +1 倍率", "en": "With 20 or fewer library blocks, +1 mult per cleared cell"},
  {"key": "gene.128.name", "zh": "精库基因", "en": "Lean Library Gene"},
  {"key": "gene.129.desc", "zh": "每个盲注开始时，方块库里随机 2 块变成库里数量最多的那种形状", "en": "Each blind start turns 2 random library blocks into the most common shape"},
  {"key": "gene.129.name", "zh": "转形基因", "en": "Reshape Gene"},
  {"key": "gene.13.desc", "zh": "每个盲注开始时随机指定一种形状；每弃掉 1 块这种形状，本基因 +5 底分（累加）", "en": "Each blind picks a random shape; +5 chips permanently per discarded piece of it"},
  {"key": "gene.13.name", "zh": "塑形基因", "en": "Sculpt Gene"},
  {"key": "gene.130.desc", "zh": "每个盲注第一次放置若触发消除，把放下的那块（连强化、版本）复制一块加进方块库", "en": "The first clearing placement each blind copies that block (with enhancement and edition) into the library"},
  {"key": "gene.130.name", "zh": "复制基因", "en": "Copy Gene"},
  {"key": "gene.131.desc", "zh": "本局每用过 1 张改造，+1 倍率", "en": "+1 mult per mod used this run"},
  {"key": "gene.131.name", "zh": "卜算基因", "en": "Divination Gene"},
  {"key": "gene.132.desc", "zh": "每开 1 个补给包，1/2 概率得 1 张随机改造（道具栏要有空）", "en": "Each booster opened: 1/2 chance for a random mod, if there is room"},
  {"key": "gene.132.name", "zh": "开包基因", "en": "Pack Luck Gene"},
  {"key": "gene.133.desc", "zh": "线数 ≥ 3 的消除，1/4 概率得 1 张随机改造（道具栏要有空）", "en": "A clear of 3+ lines: 1/4 chance for a random mod, if there is room"},
  {"key": "gene.133.name", "zh": "球击基因", "en": "Eight Ball Gene"},
  {"key": "gene.134.desc", "zh": "每用 1 张科技，本基因 +×0.1 倍率，从 ×1 起", "en": "+x0.1 mult permanently per tech used, starting from x1"},
  {"key": "gene.134.name", "zh": "星图基因", "en": "Star Chart Gene"},
  {"key": "gene.135.desc", "zh": "每个盲注开始时，得 1 张随机改造（道具栏要有空）", "en": "Each blind start grants a random mod, if there is room"},
  {"key": "gene.135.name", "zh": "预备基因", "en": "Prepare Gene"},
  {"key": "gene.136.desc", "zh": "商店里的科技和装科技的补给包免费", "en": "Techs and tech boosters in the shop are free"},
  {"key": "gene.136.name", "zh": "星价基因", "en": "Star Price Gene"},
  {"key": "gene.137.desc", "zh": "每个盲注结束时，本局每用过 1 种科技 +$1", "en": "At each blind\u0027s end, +$1 per distinct tech used this run"},
  {"key": "gene.137.name", "zh": "星金基因", "en": "Star Gold Gene"},
  {"key": "gene.138.desc", "zh": "清屏时得 1 张随机科技（道具栏要有空）", "en": "An all-clear grants a random tech, if there is room"},
  {"key": "gene.138.name", "zh": "灵感基因", "en": "Inspiration Gene"},
  {"key": "gene.139.desc", "zh": "每个盲注第一次弃置时，上一次消除的类型科技等级 +1", "en": "The first discard each blind raises the last clear type\u0027s tech level by 1"},
  {"key": "gene.139.name", "zh": "焦痕基因", "en": "Scorch Gene"},
  {"key": "gene.14.desc", "zh": "放下的那块是 I 块时，被消的每格重触发 1 次", "en": "If the placed block is an I, retrigger every cleared cell once"},
  {"key": "gene.14.name", "zh": "贯穿基因", "en": "Pierce Gene"},
  {"key": "gene.140.desc", "zh": "本局每跳过 1 个盲注，+4 倍率", "en": "+4 mult per node skipped this run"},
  {"key": "gene.140.name", "zh": "跳关基因", "en": "Skip Gene"},
  {"key": "gene.141.desc", "zh": "商店每刷新 1 次，本基因 +1 倍率（累加）", "en": "+1 mult permanently per shop reroll"},
  {"key": "gene.141.name", "zh": "刷新基因", "en": "Reroll Gene"},
  {"key": "gene.142.desc", "zh": "每卖掉 1 张（基因或消耗品），本基因 +×0.2 倍率，从 ×1 起；打过首领后归回 ×1", "en": "+x0.2 mult per item sold, starting from x1; resets after a boss"},
  {"key": "gene.142.name", "zh": "卖焰基因", "en": "Sell Flame Gene"},
  {"key": "gene.143.desc", "zh": "首领盲注里，每次消除 +$1", "en": "+$1 per clear in a boss blind"},
  {"key": "gene.143.name", "zh": "斗首基因", "en": "Matador Gene"},
  {"key": "gene.144.desc", "zh": "卖掉本基因时，当前首领盲注的负面效果失效", "en": "Selling this gene disables the current boss blind\u0027s negative effect"},
  {"key": "gene.144.name", "zh": "摔跤基因", "en": "Wrestler Gene"},
  {"key": "gene.145.desc", "zh": "盲注失败时，若得分达到目标分的 1/4，改判通关，本基因随后湮灭", "en": "On defeat, if you reached 1/4 of the target, win instead; this gene is destroyed"},
  {"key": "gene.145.name", "zh": "免死基因", "en": "Undying Gene"},
  {"key": "gene.146.desc", "zh": "被消的 I 块和 O 块，每格 ×1.25 倍率", "en": "×1.25 mult per cleared I or O cell"},
  {"key": "gene.146.name", "zh": "双柱基因", "en": "Twin Pillar Gene"},
  {"key": "gene.147.desc", "zh": "首领盲注的负面效果失效", "en": "Boss blinds\u0027 negative effects are disabled"},
  {"key": "gene.147.name", "zh": "赦免基因", "en": "Pardon Gene"},
  {"key": "gene.148.desc", "zh": "每有 1 块方块湮灭（琉璃碎裂或被删），本基因 +×0.5 倍率，从 ×1 起", "en": "+x0.5 mult per block destroyed this run, starting from x1"},
  {"key": "gene.148.name", "zh": "永续基因", "en": "Eternal Gene"},
  {"key": "gene.149.desc", "zh": "本局每累计弃掉 10 块，本基因 +×1 倍率，从 ×1 起", "en": "+x1 mult per 10 pieces discarded this run, starting from x1"},
  {"key": "gene.149.name", "zh": "回响基因", "en": "Echo Gene"},
  {"key": "gene.15.desc", "zh": "消除类型是同形态或同形态十字时，×3 倍率。代价：拿到后首个盲注目标分 +25%", "en": "×3 mult on Same Shape or Same Shape Cross. Cost: next blind target +25%"},
  {"key": "gene.15.name", "zh": "纯形基因", "en": "Purity Gene"},
  {"key": "gene.150.desc", "zh": "每个盲注结束时，复制道具栏里随机 1 张消耗品（道具栏要有空）", "en": "At each blind\u0027s end, copy a random consumable in your tray, if there is room"},
  {"key": "gene.150.name", "zh": "留影基因", "en": "Afterimage Gene"},
  {"key": "gene.16.desc", "zh": "本盲注 7 种形状都放下过之后，每次消除 ×2.5 倍率", "en": "x2.5 mult once all seven shapes have been placed this blind"},
  {"key": "gene.16.name", "zh": "七形基因", "en": "Seven Shapes Gene"},
  {"key": "gene.17.desc", "zh": "被消格所属块点数为奇数，每格 +4 底分", "en": "+4 chips per cleared cell of an odd-point block"},
  {"key": "gene.17.name", "zh": "奇数基因", "en": "Odd Gene"},
  {"key": "gene.18.desc", "zh": "被消格所属块点数为偶数，每格 +0.5 倍率", "en": "+0.5 mult per cleared cell of an even-point block"},
  {"key": "gene.18.name", "zh": "偶数基因", "en": "Even Gene"},
  {"key": "gene.19.desc", "zh": "被消格所属块点数为 1，每格 +1 倍率", "en": "+1 mult per cleared cell of a 1-point block"},
  {"key": "gene.19.name", "zh": "低点基因", "en": "Low Point Gene"},
  {"key": "gene.2.desc", "zh": "每被消 1 格 O 块，+6 底分", "en": "+6 chips per cleared O-block cell"},
  {"key": "gene.2.name", "zh": "方核基因", "en": "Square Core Gene"},
  {"key": "gene.20.desc", "zh": "待放置区里点数最低那块的点数 ×2，加进倍率", "en": "Adds 2× the lowest points in your tray to mult"},
  {"key": "gene.20.name", "zh": "拳点基因", "en": "Fist Gene"},
  {"key": "gene.21.desc", "zh": "这次被消格里有 ≥ 3 种不同点数时，+25 底分", "en": "+25 chips if cleared cells show 3+ different points"},
  {"key": "gene.21.name", "zh": "点阶基因", "en": "Gradient Gene"},
  {"key": "gene.22.desc", "zh": "点数 ≥ 4 的块，被消的每格重触发 1 次", "en": "Retrigger cleared cells of blocks with 4+ points once"},
  {"key": "gene.22.name", "zh": "重码基因", "en": "Heavy Code Gene"},
  {"key": "gene.23.desc", "zh": "这次被消的格点数全部相同时，+15 倍率", "en": "+15 mult when every cleared cell has the same points"},
  {"key": "gene.23.name", "zh": "齐点基因", "en": "Uniform Gene"},
  {"key": "gene.24.desc", "zh": "被消格计点数时按 2 倍计", "en": "Cleared cells count their points twice"},
  {"key": "gene.24.name", "zh": "倍点基因", "en": "Double Points Gene"},
  {"key": "gene.25.desc", "zh": "每次消除后，这次被消格最多的那块点数永久 +1", "en": "After each clear, the most-cleared block gains +1 point permanently"},
  {"key": "gene.25.name", "zh": "加码基因", "en": "Stepper Gene"},
  {"key": "gene.26.desc", "zh": "被消格的点数不加进底分，改成每 2 点 +0.5 倍率", "en": "Cleared points go to mult at +0.5 per 2 points instead of chips"},
  {"key": "gene.26.name", "zh": "转码基因", "en": "Transcode Gene"},
  {"key": "gene.27.desc", "zh": "这次被消格的点数全部 ≥ 3 时，×2.5 倍率。代价：每个盲注弃置 −1", "en": "×2.5 mult if every cleared cell has 3+ points. Cost: −1 discard per blind"},
  {"key": "gene.27.name", "zh": "巅点基因", "en": "Peak Gene"},
  {"key": "gene.28.desc", "zh": "待放置区里每有 1 块点数 ≥ 4 的块，×1.5 倍率。代价：拿到后首个盲注目标分 +20%", "en": "×1.5 mult per 4+ point block left in your tray. Cost: next blind target +20%"},
  {"key": "gene.28.name", "zh": "握点基因", "en": "Grip Gene"},
  {"key": "gene.29.desc", "zh": "被消格在网格四角之一，每格 +4 倍率", "en": "+4 mult per cleared corner cell"},
  {"key": "gene.29.name", "zh": "四隅基因", "en": "Corner Gene"},
  {"key": "gene.3.desc", "zh": "每被消 1 格 T 块，+1 倍率", "en": "+1 mult per cleared T-block cell"},
  {"key": "gene.3.name", "zh": "三叉基因", "en": "Trident Gene"},
  {"key": "gene.30.desc", "zh": "被消格属于放下的那块，每格 +1 倍率", "en": "+1 mult per cleared cell of the block you just placed"},
  {"key": "gene.30.name", "zh": "落点基因", "en": "Landing Gene"},
  {"key": "gene.31.desc", "zh": "被消格在中心 4×4，每格 +0.5 倍率", "en": "+0.5 mult per cleared cell in the centre 4×4"},
  {"key": "gene.31.name", "zh": "核心基因", "en": "Core Gene"},
  {"key": "gene.32.desc", "zh": "消除里每有 1 条贴边的线（第 1、8 行或第 1、8 列），+5 倍率", "en": "+5 mult per cleared edge line (row 1/8, column 1/8)"},
  {"key": "gene.32.name", "zh": "边线基因", "en": "Border Gene"},
