{
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|bash|PowerShell|pwsh)$",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\提交检查.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*Git*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\提交检查.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*GIT*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\提交检查.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*run_tests*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\提交检查.ps1\"",
