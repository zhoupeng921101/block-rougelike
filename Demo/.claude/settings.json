            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*.bat*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\命令通路检查.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*.Bat*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\命令通路检查.ps1\"",
