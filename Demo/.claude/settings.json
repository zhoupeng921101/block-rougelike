          {
            "type": "command",
            "if": "PowerShell(*交付.ps1*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\命令通路检查.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(bash|pwsh)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}\\.claude\\devflow\\hooks\\提交检查.ps1\"",
            "timeout": 60
